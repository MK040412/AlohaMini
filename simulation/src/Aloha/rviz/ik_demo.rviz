Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Line Style:
        Value: Lines
      Cell Size: 0.1
      Plane Cell Count: 20
    - Alpha: 0.8
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Frame Timeout: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: IK Markers
      Marker Topic:
        Value: /ik_markers
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Interactive Markers
      Update Topic:
        Value: /ik_targets/update
      Enabled: true
      Value: true
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Name: Current View
      Pitch: 0.45
      Value: Orbit (rviz)
      Yaw: 5.5
Window Geometry:
  Height: 900
  Width: 1400
