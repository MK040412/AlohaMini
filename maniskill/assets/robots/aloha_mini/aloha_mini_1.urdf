  <joint name="right_wrist_flex" type="revolute">
    <origin xyz="0 0.0052 0.1349" rpy="-1.5708 0 0" />
    <parent link="right_Lower_Arm" />
    <child link="right_Wrist_Pitch_Roll" />
    <axis xyz="1 0 0" />
    <limit lower="-1.8" upper="1.8" effort="0" velocity="0" />
  </joint>

  <!-- ===== Right gripper body = roboninecom SO-ARM101 link5_1 (wrist) =====
       Mirror of the left arm; same real GPL-3.0 clamp assets (clamp_meshes/). -->
  <link name="right_Fixed_Jaw">
    <inertial>
      <origin xyz="-0.000584 -0.041539 0.015056" rpy="0 0 0"/>
      <mass value="0.556172"/>
      <inertia ixx="0.000579" iyy="0.000983" izz="0.000737" ixy="1e-06" iyz="-8.4e-05" ixz="-5e-06"/>
    </inertial>
    <visual name="right_gripper_body">
      <origin xyz="-0.007062 0.120627 -0.152066" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/link5_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="-0.007062 0.120627 -0.152066" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/link5_1_collision.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wrist_roll" type="revolute">
    <origin xyz="0 -0.0601 0" rpy="0 1.5708 0" />
    <parent link="right_Wrist_Pitch_Roll" />
    <child link="right_Fixed_Jaw" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="0" velocity="0" />
  </joint>

  <!-- ===== Right parallel gripper: roboninecom clamps (real meshes) =====
       Same as the left arm; finger2 axis negated so the agent's mimic (+1) opens
       both jaws. qpos 0 = closed (CAD pose), qpos 0.037 = fully open. -->
  <link name="right_finger1">  <!-- = clamp_1 -->
    <inertial>
      <origin xyz="0.060170 0.144807 0.184483" rpy="0 0 0"/>
      <mass value="0.153812"/>
      <inertia ixx="8.6e-05" iyy="4.1e-05" izz="7.3e-05" ixy="-1e-06" iyz="4e-06" ixz="-2e-06"/>
    </inertial>
    <visual name="right_clamp1">
      <origin xyz="0.045072 0.340704 0.033971" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/clamp_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Collision = flat box pad, offset OUTBOARD of the jaw tip so its inner
         face sits at the tip (grasp contact line). This gives a clean face-face
         contact with a grasped object and avoids the deep convex-hull penetration
         (which ejected objects on lift). Detailed clamp mesh kept as the visual. -->
    <collision>
      <origin xyz="0.062 0.129 0.186" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.055 0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint1" type="prismatic">  <!-- = right_clamp -->
    <origin xyz="-0.052134 -0.220077 -0.186037" rpy="0 0 0"/>
    <parent link="right_Fixed_Jaw"/>
    <child link="right_finger1"/>
    <axis xyz="0.999848 -0.000154 0.017451"/>
    <limit lower="0.0" upper="0.037" effort="50" velocity="0.05"/>
  </joint>

  <link name="right_finger2">  <!-- = clamp_2 -->
    <inertial>
      <origin xyz="-0.080004 0.147010 0.185068" rpy="0 0 0"/>
      <mass value="0.153812"/>
      <inertia ixx="8.6e-05" iyy="4.1e-05" izz="7.3e-05" ixy="1e-06" iyz="-4e-06" ixz="-2e-06"/>
    </inertial>
    <visual name="right_clamp2">
      <origin xyz="-0.07989 0.342905 0.031809" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/clamp_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="-0.083 0.131 0.184" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.055 0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint2" type="prismatic">  <!-- = left_clamp (axis negated) -->
    <origin xyz="0.072828 -0.222278 -0.183875" rpy="0 0 0"/>
    <parent link="right_Fixed_Jaw"/>
    <child link="right_finger2"/>
    <axis xyz="-0.999848 0.000154 -0.017451"/>
    <limit lower="0.0" upper="0.037" effort="50" velocity="0.05"/>
  </joint>

  <joint name="right_finger1_tip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.051981 0.1288995 0.186081"/>
    <parent link="right_finger1"/>
    <child link="right_finger1_tip"/>
  </joint>
  <link name="right_finger1_tip" />

  <joint name="right_finger2_tip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.072981 0.1311005 0.183919"/>
    <parent link="right_finger2"/>
    <child link="right_finger2_tip"/>
  </joint>
  <link name="right_finger2_tip" />

</robot>
