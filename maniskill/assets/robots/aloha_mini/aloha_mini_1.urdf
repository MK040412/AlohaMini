<?xml version="1.0" encoding="utf-8"?>
<!-- AlohaMini with official ManiSkill SO100 Arms -->
<!-- Base structure from aloha_mini_virtual_base.urdf -->
<!-- Arms from ManiSkill so100.urdf with left_/right_ prefixes -->
<robot name="aloha_mini_maniskill_so100">

  <material name="white">
    <color rgba="0.95 0.95 0.95 1" />
  </material>
  <material name="motor">
    <color rgba="0.05 0.05 0.05 1" />
  </material>

  <!-- Virtual Base Links (zero mass) for mobile base simulation -->
  <link name="root">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>

  <link name="root_x_link">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>

  <link name="root_y_link">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>

  <!-- Virtual Base Joints -->
  <joint name="root_x_axis_joint" type="prismatic">
    <parent link="root"/>
    <child link="root_x_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="500" lower="-20" upper="20" velocity="1.0"/>
    <dynamics damping="100.0" friction="10"/>
  </joint>

  <joint name="root_y_axis_joint" type="prismatic">
    <parent link="root_x_link"/>
    <child link="root_y_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="500" lower="-20" upper="20" velocity="1.0"/>
    <dynamics damping="100.0" friction="10"/>
  </joint>

  <joint name="root_z_rotation_joint" type="continuous">
    <parent link="root_y_link"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="100.0" friction="10"/>
  </joint>

  <!-- Physical Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00084648 0.00978917 0.34475333" rpy="0 0 0" />
      <mass value="5.09802085" />
      <inertia ixx="0.02139147" ixy="-9.32122e-05" ixz="2.18297e-05"
               iyy="0.02009437" iyz="-0.00021314" izz="0.02209675" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Wheels (visual only) -->
  <link name="wheel1">
    <inertial>
      <origin xyz="-5.2749e-05 0.01577411 -1.8443e-07" rpy="0 0 0" />
      <mass value="0.19481896" />
      <inertia ixx="5.0889e-05" ixy="3.6052e-11" ixz="2.6907e-11"
               iyy="9.3635e-05" iyz="-4.4529e-12" izz="5.089e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wheel1.STL" />
      </geometry>
      <material name="white" />
    </visual>
  </link>
  <joint name="wheel1_joint" type="fixed">
    <origin xyz="-0.1538 0.091161 0.0422" rpy="0 0 -2.1099" />
    <parent link="base_link" />
    <child link="wheel1" />
  </joint>

  <link name="wheel2">
    <inertial>
      <origin xyz="-6.4495e-06 0.01577407 -5.2356e-05" rpy="0 0 0" />
      <mass value="0.19481804" />
      <inertia ixx="5.089e-05" ixy="-1.2087e-12" ixz="-2.0278e-10"
               iyy="9.3635e-05" iyz="5.3546e-11" izz="5.0889e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wheel2.STL" />
      </geometry>
      <material name="white" />
    </visual>
  </link>
  <joint name="wheel2_joint" type="fixed">
    <origin xyz="0.15563 0.087993 0.0422" rpy="0 0 2.086" />
    <parent link="base_link" />
    <child link="wheel2" />
  </joint>

  <link name="wheel3">
    <inertial>
      <origin xyz="0.00021759 0.01577265 -4.564e-05" rpy="0 0 0" />
      <mass value="0.19481853" />
      <inertia ixx="5.09e-05" ixy="6.6162e-07" ixz="-7.5485e-10"
               iyy="9.3625e-05" iyz="7.6853e-11" izz="5.089e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wheel3.STL" />
      </geometry>
      <material name="white" />
    </visual>
  </link>
  <joint name="wheel3_joint" type="fixed">
    <origin xyz="-0.0020354 -0.17875 0.0422" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel3" />
  </joint>

  <!-- Vertical Link (Lift) -->
  <link name="vertical_link">
    <inertial>
      <origin xyz="-0.00028187 0.00785824 0.63016724" rpy="0 0 0" />
      <mass value="1.13349901" />
      <inertia ixx="0.00108584" ixy="2.1331e-05" ixz="-1.0049e-05"
               iyy="0.00311025" iyz="-2.9641e-05" izz="0.00240766" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/vertical_link.STL" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/vertical_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="vertical_move" type="prismatic">
    <origin xyz="-0.001045 -0.067891 0.064" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="vertical_link" />
    <axis xyz="0 0 1" />
    <!-- travel from upstream liyiteng/alohamini alohamini2pro.urdf -->
    <limit lower="-0.3" upper="0.3" effort="100" velocity="0.5" />
  </joint>

  <!-- ========== LEFT ARM (Official ManiSkill SO100) ========== -->
  <!-- Position: positive X (like aloha_mini_virtual_base.urdf) -->
  <link name="left_Base">
    <inertial>
      <origin xyz="-2.45960666746703E-07 0.0311418169687909 0.0175746661003382" rpy="0 0 0" />
      <mass value="0.193184127927598" />
      <inertia ixx="0.000137030709467877" ixy="2.10136126944992E-08" ixz="4.24087422551286E-09"
               iyy="0.000169089551209259" iyz="2.26514711036514E-05" izz="0.000145097720857224" />
    </inertial>
    <visual name="left_base_link_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="left_base_link_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Left arm base joint: NO rotation, position only -->
  <joint name="left_base_joint" type="fixed">
    <origin xyz="0.15726 0.026474 0.68821" rpy="0 0 0" />
    <parent link="vertical_link" />
    <child link="left_Base" />
  </joint>

  <link name="left_Rotation_Pitch">
    <inertial>
      <origin xyz="-9.07886224712597E-05 0.0590971820568318 0.031089016892169" rpy="0 0 0" />
      <mass value="0.119226314127197" />
      <inertia ixx="5.90408775624429E-05" ixy="4.90800532852998E-07" ixz="-5.90451772654387E-08"
               iyy="3.21498601038881E-05" iyz="-4.58026206663885E-06" izz="5.86058514263952E-05" />
    </inertial>
    <visual name="left_rotation_pitch_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="left_rotation_pitch_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Left shoulder_pan: official ManiSkill SO100 rotation -->
  <joint name="left_shoulder_pan" type="revolute">
    <origin xyz="0 -0.0452 0.0165" rpy="1.5708 0 0" />
    <parent link="left_Base" />
    <child link="left_Rotation_Pitch" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.0" upper="2.0" effort="0" velocity="0" />
  </joint>

  <link name="left_Upper_Arm">
    <inertial>
      <origin xyz="-1.7205170190925E-05 0.0701802156327694 0.00310545118155671" rpy="0 0 0" />
      <mass value="0.162409284599177" />
      <inertia ixx="0.000167153146617081" ixy="1.03902689187701E-06" ixz="-1.20161820645189E-08"
               iyy="7.01946992214245E-05" iyz="2.11884806298698E-06" izz="0.000213280241160769" />
    </inertial>
    <visual name="left_upper_arm_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="left_upper_arm_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="left_shoulder_lift" type="revolute">
    <origin xyz="0 0.1025 0.0306" rpy="0 0 0" />
    <parent link="left_Rotation_Pitch" />
    <child link="left_Upper_Arm" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="0" velocity="0" />
  </joint>

  <link name="left_Lower_Arm">
    <inertial>
      <origin xyz="-0.00339603710186651 0.00137796353960074 0.0768006751156044" rpy="0 0 0" />
      <mass value="0.147967774582291" />
      <inertia ixx="0.000105333995841409" ixy="1.73059237226499E-07" ixz="-1.1720305455211E-05"
               iyy="0.000138766654485212" iyz="1.77429964684103E-06" izz="5.08741652515214E-05" />
    </inertial>
    <visual name="left_lower_arm_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Lower_Arm.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="left_lower_arm_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Lower_Arm_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Lower_Arm.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="left_elbow_flex" type="revolute">
    <origin xyz="0 0.11257 0.028" rpy="0 0 0" />
    <parent link="left_Upper_Arm" />
    <child link="left_Lower_Arm" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="0" velocity="0" />
  </joint>

  <link name="left_Wrist_Pitch_Roll">
    <inertial>
      <origin xyz="-0.00852653127372418 -0.0352278997897927 -2.34622481569413E-05" rpy="0 0 0" />
      <mass value="0.066132067097723" />
      <inertia ixx="1.95717492443445E-05" ixy="-6.62714374412293E-07" ixz="5.20089016442066E-09"
               iyy="2.38028417569933E-05" iyz="4.09549055863776E-08" izz="3.4540143384536E-05" />
    </inertial>
    <visual name="left_wrist_pitch_roll_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Wrist_Pitch_Roll.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="left_wrist_pitch_roll_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Wrist_Pitch_Roll_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Wrist_Pitch_Roll.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wrist_flex" type="revolute">
    <origin xyz="0 0.0052 0.1349" rpy="-1.5708 0 0" />
    <parent link="left_Lower_Arm" />
    <child link="left_Wrist_Pitch_Roll" />
    <axis xyz="1 0 0" />
    <limit lower="-1.8" upper="1.8" effort="0" velocity="0" />
  </joint>

  <!-- ===== Left gripper body = roboninecom SO-ARM101 link5_1 (wrist) =====
       Real GPL-3.0 parallel-gripper assets from
       github.com/roboninecom/SO-ARM100-101-Parallel-Gripper (see clamp_meshes/).
       Kept under the AlohaMini link name `left_Fixed_Jaw` so the agent (cameras,
       wrist_roll child, grasp checks) is unchanged. Origins are verbatim from
       so_101.urdf.xacro (link5_1 frame); meshes are in mm (scale 0.001). -->
  <link name="left_Fixed_Jaw">
    <inertial>
      <origin xyz="-0.000584 -0.041539 0.015056" rpy="0 0 0"/>
      <mass value="0.556172"/>
      <inertia ixx="0.000579" iyy="0.000983" izz="0.000737" ixy="1e-06" iyz="-8.4e-05" ixz="-5e-06"/>
    </inertial>
    <visual name="left_gripper_body">
      <origin xyz="-0.007062 0.120627 -0.152066" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/link5_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="-0.007062 0.120627 -0.152066" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/link5_1_collision.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wrist_roll" type="revolute">
    <!-- Mounts the roboninecom gripper body on the AlohaMini wrist. TUNABLE. -->
    <origin xyz="0 -0.0601 0" rpy="0 1.5708 0" />
    <parent link="left_Wrist_Pitch_Roll" />
    <child link="left_Fixed_Jaw" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="0" velocity="0" />
  </joint>

  <!-- ===== Left parallel gripper: roboninecom clamps (real meshes) =====
       clamp_1 = right_clamp, clamp_2 = left_clamp. In so_101 they share one axis
       with left_clamp mimic*-1; here finger2's axis is NEGATED so the agent's
       existing mimic (multiplier +1) opens both jaws symmetrically. qpos 0 =
       closed (CAD pose), qpos 0.037 = fully open (~74 mm stroke). -->
  <link name="left_finger1">  <!-- = clamp_1 -->
    <inertial>
      <origin xyz="0.060170 0.144807 0.184483" rpy="0 0 0"/>
      <mass value="0.153812"/>
      <inertia ixx="8.6e-05" iyy="4.1e-05" izz="7.3e-05" ixy="-1e-06" iyz="4e-06" ixz="-2e-06"/>
    </inertial>
    <visual name="left_clamp1">
      <origin xyz="0.045072 0.340704 0.033971" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/clamp_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Collision = flat box pad, offset OUTBOARD of the jaw tip so its inner
         face sits at the tip (grasp contact line). This gives a clean face-face
         contact with a grasped object and avoids the deep convex-hull penetration
         (which ejected objects on lift). Detailed clamp mesh kept as the visual. -->
    <collision>
      <origin xyz="0.062 0.129 0.186" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.055 0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_finger_joint1" type="prismatic">  <!-- = right_clamp -->
    <origin xyz="-0.052134 -0.220077 -0.186037" rpy="0 0 0"/>
    <parent link="left_Fixed_Jaw"/>
    <child link="left_finger1"/>
    <axis xyz="0.999848 -0.000154 0.017451"/>
    <limit lower="0.0" upper="0.037" effort="50" velocity="0.05"/>
  </joint>

  <link name="left_finger2">  <!-- = clamp_2 -->
    <inertial>
      <origin xyz="-0.080004 0.147010 0.185068" rpy="0 0 0"/>
      <mass value="0.153812"/>
      <inertia ixx="8.6e-05" iyy="4.1e-05" izz="7.3e-05" ixy="1e-06" iyz="-4e-06" ixz="-2e-06"/>
    </inertial>
    <visual name="left_clamp2">
      <origin xyz="-0.07989 0.342905 0.031809" rpy="0 0 0"/>
      <geometry>
        <mesh filename="clamp_meshes/clamp_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="-0.083 0.131 0.184" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.055 0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_finger_joint2" type="prismatic">  <!-- = left_clamp (axis negated, see note) -->
    <origin xyz="0.072828 -0.222278 -0.183875" rpy="0 0 0"/>
    <parent link="left_Fixed_Jaw"/>
    <child link="left_finger2"/>
    <axis xyz="-0.999848 0.000154 -0.017451"/>
    <limit lower="0.0" upper="0.037" effort="50" velocity="0.05"/>
  </joint>

  <!-- Tips at the gripper grasp center (TCP = midpoint). Closed-pose values so
       both tips coincide at the center when qpos=0. -->
  <joint name="left_finger1_tip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.051981 0.1288995 0.186081"/>
    <parent link="left_finger1"/>
    <child link="left_finger1_tip"/>
  </joint>
  <link name="left_finger1_tip" />

  <joint name="left_finger2_tip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.072981 0.1311005 0.183919"/>
    <parent link="left_finger2"/>
    <child link="left_finger2_tip"/>
  </joint>
  <link name="left_finger2_tip" />

  <!-- ========== RIGHT ARM (Official ManiSkill SO100) ========== -->
  <!-- Position: negative X (like aloha_mini_virtual_base.urdf) -->
  <link name="right_Base">
    <inertial>
      <origin xyz="-2.45960666746703E-07 0.0311418169687909 0.0175746661003382" rpy="0 0 0" />
      <mass value="0.193184127927598" />
      <inertia ixx="0.000137030709467877" ixy="2.10136126944992E-08" ixz="4.24087422551286E-09"
               iyy="0.000169089551209259" iyz="2.26514711036514E-05" izz="0.000145097720857224" />
    </inertial>
    <visual name="right_base_link_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="right_base_link_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Base.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Right arm base joint: NO rotation, position only -->
  <joint name="right_base_joint" type="fixed">
    <origin xyz="-0.15657564 0.03021825 0.68890773" rpy="0 0 0" />
    <parent link="vertical_link" />
    <child link="right_Base" />
  </joint>

  <link name="right_Rotation_Pitch">
    <inertial>
      <origin xyz="-9.07886224712597E-05 0.0590971820568318 0.031089016892169" rpy="0 0 0" />
      <mass value="0.119226314127197" />
      <inertia ixx="5.90408775624429E-05" ixy="4.90800532852998E-07" ixz="-5.90451772654387E-08"
               iyy="3.21498601038881E-05" iyz="-4.58026206663885E-06" izz="5.86058514263952E-05" />
    </inertial>
    <visual name="right_rotation_pitch_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="right_rotation_pitch_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Rotation_Pitch.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Right shoulder_pan: official ManiSkill SO100 rotation -->
  <joint name="right_shoulder_pan" type="revolute">
    <origin xyz="0 -0.0452 0.0165" rpy="1.5708 0 0" />
    <parent link="right_Base" />
    <child link="right_Rotation_Pitch" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.0" upper="2.0" effort="0" velocity="0" />
  </joint>

  <link name="right_Upper_Arm">
    <inertial>
      <origin xyz="-1.7205170190925E-05 0.0701802156327694 0.00310545118155671" rpy="0 0 0" />
      <mass value="0.162409284599177" />
      <inertia ixx="0.000167153146617081" ixy="1.03902689187701E-06" ixz="-1.20161820645189E-08"
               iyy="7.01946992214245E-05" iyz="2.11884806298698E-06" izz="0.000213280241160769" />
    </inertial>
    <visual name="right_upper_arm_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm.stl" />
      </geometry>
      <material name="white" />
    </visual>
    <visual name="right_upper_arm_motor">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm_Motor.stl" />
      </geometry>
      <material name="motor" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Upper_Arm.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="right_shoulder_lift" type="revolute">
    <origin xyz="0 0.1025 0.0306" rpy="0 0 0" />
    <parent link="right_Rotation_Pitch" />
    <child link="right_Upper_Arm" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="0" velocity="0" />
  </joint>

  <link name="right_Lower_Arm">
    <inertial>
      <origin xyz="-0.00339603710186651 0.00137796353960074 0.0768006751156044" rpy="0 0 0" />
      <mass value="0.147967774582291" />
      <inertia ixx="0.000105333995841409" ixy="1.73059237226499E-07" ixz="-1.1720305455211E-05"
               iyy="0.000138766654485212" iyz="1.77429964684103E-06" izz="5.08741652515214E-05" />
    </inertial>
    <visual name="right_lower_arm_chassis">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="so100_meshes/Lower_Arm.stl" />
